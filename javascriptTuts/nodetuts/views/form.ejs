<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bootstrap demo</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <div class="border border-black mt-5  w-75 m-auto bg-secondary-subtle">
      <div class="bg-primary text-center p-1 m-auto w-50 text-white mt-5 ">
        <h3>Registration Form</h3>
      </div>
      <div class="w-50 m-auto pt-5">
         <form action="/submit" method="POST">
             <div>
                <div>
                    <label for="name">Name :</label>
                    <input type="text" id="name" name="uname">
                </div>
                  <div>
                    <label for="mob">Mobile :</label>
                    <input type="number" id="mob" name="mob">
                </div>
                  <div>
                    <label for="email">Email :</label>
                    <input type="email" id="email" name="email">
                </div>
                     <div>
                    <label for="msg">Message :</label>
                    <input type="text" id="msg" name="msg">
                </div>
             </div>
             <div class=" m-auto  mt-2 w-50 submit">
                <input type="submit" value="Submit" class="bg-success text-white w-75 ">
             </div>
             </div>
         </form>
      </div>

     <%-include("data")-%>
    </div>
  </body>
</html>
