<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="../style.css" />
  </head>
  <body>
    <div class="container">
      <table border="1" width="100%">
        <thead>
          <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Salary</th>
            <th>City</th>
          </tr>
        </thead>
        <tbody>
          <%stu.map((item,index)=>{%>
          <tr>
            <td><%=item.name%></td>
            <td><%=item.age%></td>
            <td><%=item.salary%></td>
            <td><%=item.city%></td>
          </tr>
          <%})%>
        </tbody>
      </table>
    </div>
  </body>
</html>
